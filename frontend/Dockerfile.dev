FROM node:24-slim

WORKDIR /workspace/frontend

# git commit時にpre-commitフック（.husky/pre-commit）が使うgitleaksのバージョン。
# 更新する場合はbackend/Dockerfile.devも合わせて更新すること。
ARG GITLEAKS_VERSION=8.30.1

RUN apt-get update \
   && apt-get install -y --no-install-recommends \
   ca-certificates \
   curl \
   git \
   gnupg \
   openssh-client \
   && install -m 0755 -d /etc/apt/keyrings \
   && curl -fsSL https://download.docker.com/linux/debian/gpg \
   | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
   && chmod a+r /etc/apt/keyrings/docker.gpg \
   && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
   https://download.docker.com/linux/debian bookworm stable" \
   | tee /etc/apt/sources.list.d/docker.list > /dev/null \
   && apt-get update \
   && apt-get install -y --no-install-recommends docker-ce-cli \
   && rm -rf /var/lib/apt/lists/*

# gitleaks（.husky/pre-commitが利用。devcontainer内には標準で入っていないため同梱する）
RUN set -eux; \
   arch="$(dpkg --print-architecture)"; \
   case "$arch" in \
       amd64) gitleaks_arch=x64 ;; \
       arm64) gitleaks_arch=arm64 ;; \
       *) echo "unsupported arch for gitleaks: $arch" >&2; exit 1 ;; \
   esac; \
   curl -fsSL -o /tmp/gitleaks.tar.gz \
       "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${gitleaks_arch}.tar.gz" \
   && tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks \
   && rm /tmp/gitleaks.tar.gz \
   && gitleaks version

COPY package*.json ./

RUN npm install

# Claude Code用Playwright MCPサーバ（.mcp.json）がこのコンテナ内でヘッドレスブラウザを
# 起動できるようにするための事前インストール。OS側の共有ライブラリ（libnss3等）のみを
# ここでイメージに焼き込む（install-deps、apt経由）。Chromium本体のダウンロードは含めない：
# 本体は/root/.cache/ms-playwrightに入るが、そこはcompose.dev.ymlでnamed volume
# （frontend_playwright_cache）にしており、イメージ再ビルドのたびに再ダウンロードしたくない
# ため。本体のダウンロードはdevcontainer.jsonのpostCreateCommand側で行う（2回目以降は
# volumeにキャッシュ済みのためスキップされる）。
RUN npx --yes playwright install-deps chromium

COPY . .

CMD ["npm", "run", "dev"]