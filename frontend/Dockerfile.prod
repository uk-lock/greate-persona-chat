FROM node:24-slim AS builder

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

# lib/config.tsのAPI_BASE_URLはgetterで参照時まで評価を遅らせており、実際に読まれるのは
# cookies()等で動的レンダリングが確定した後（Server Action / Route Handler / dynamicなページ）
# のみ。next build自体はconfigをimportするだけで値を読まないため、ビルド時にAPI_BASE_URLを
# 渡す必要はない（同一イメージをstaging/prod間で使い回せる。値は実行時にcompose等の
# environmentで渡す）。
RUN npm run build

FROM node:24-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
# Next.js standaloneサーバーはHOSTNAME環境変数のアドレスにのみbindするが、Dockerは全コンテナに
# 自動でHOSTNAME（コンテナ固有のホスト名）を設定してしまうため、何もしないとそのコンテナの
# 個別IPにしかbindされず、localhost/127.0.0.1はおろか外部からも到達できなくなる
# （E2E導入時に発覚。Cloud Run等コンテナランタイムがHOSTNAME相当を独自設定してくる環境でも
# 同様に起こりうる）。明示的に0.0.0.0を指定して全インターフェースで待ち受けさせる。
ENV HOSTNAME="0.0.0.0"

COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

CMD ["node", "server.js"]
